rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email' in request.auth.token && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidMessage(data) {
      return hasRequiredFields(['lookingFor', 'createdAt', 'deviceInfo']) &&
             data.lookingFor is string && data.lookingFor.size() > 0 && data.lookingFor.size() <= 1000 &&
             (!('isArchived' in data) || data.isArchived is bool) &&
             (!('when' in data) || (data.when is string && data.when.size() <= 200)) &&
             (!('where' in data) || (data.where is string && data.where.size() <= 200)) &&
             (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 200)) &&
             (!('advancedInfo' in data) || (data.advancedInfo is string && data.advancedInfo.size() <= 32000)) &&
             (!('profileGroupId' in data) || (data.profileGroupId is string && data.profileGroupId.size() <= 200)) &&
             data.createdAt is timestamp &&
             data.deviceInfo is map &&
             data.deviceInfo.keys().hasAll(['userAgent', 'language', 'platform', 'screenResolution', 'timezone']) &&
             data.deviceInfo.userAgent is string && data.deviceInfo.userAgent.size() <= 500 &&
             data.deviceInfo.language is string && data.deviceInfo.language.size() <= 50 &&
             data.deviceInfo.platform is string && data.deviceInfo.platform.size() <= 100 &&
             data.deviceInfo.screenResolution is string && data.deviceInfo.screenResolution.size() <= 50 &&
             data.deviceInfo.timezone is string && data.deviceInfo.timezone.size() <= 100;
    }

    function isValidVisit(data) {
      return data.keys().hasAll(['createdAt', 'userAgent', 'hasSubmitted']) &&
             data.createdAt is timestamp &&
             data.userAgent is string && data.userAgent.size() <= 600 &&
             data.hasSubmitted is bool &&
             (!('timeSpentWhen' in data) || data.timeSpentWhen is number) &&
             (!('timeSpentWhere' in data) || data.timeSpentWhere is number) &&
             (!('timeSpentLookingFor' in data) || data.timeSpentLookingFor is number) &&
             (!('timeSpentInstagram' in data) || data.timeSpentInstagram is number) &&
             (!('abandonedAfter' in data) || data.abandonedAfter is string);
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /logos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    function isSuperAdmin() {
      return isAuthenticated() && ('email' in request.auth.token && request.auth.token.email == 'andolinaraffaele70@gmail.com');
    }

    match /admins/{userId} {
      allow read: if isSuperAdmin() || (request.auth != null && (request.auth.uid == userId || ('email' in request.auth.token && request.auth.token.email == userId)));
      allow write: if isSuperAdmin();
    }
    match /analytics_visits/{visitId} {
      allow create: if isAuthenticated() && isValidVisit(request.resource.data);
      allow update: if isAuthenticated() && isValidVisit(request.resource.data) &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow read, delete: if isAdmin();
    }
    match /rate_limits/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.lastMessageAt == request.time &&
        (
          !exists(/databases/$(database)/documents/rate_limits/$(userId)) ||
          request.time > get(/databases/$(database)/documents/rate_limits/$(userId)).data.lastMessageAt + duration.value(30, 's')
        );
    }
    match /messages/{messageId} {
      allow create: if isAuthenticated() && isValidMessage(request.resource.data) &&
        getAfter(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.lastMessageAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /profiles/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
